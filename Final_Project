      "source": [
        "import re\n",
        "# first lets make a new row with mega evolutions excluding meganium so we can see which pokemon are mega so we can exclude them from our data if we need\n",
        "Mega_rows = df[df['Name'].str.contains('Mega', case=True, na=False) & (df['Name'] != 'Meganium')]['Name']\n",
        "\n",
        "# lets group any pokemon with mega in their name\n",
        "def get_base_name(Mega_name):\n",
        "    match = re.match(r'^(.*?)Mega', Mega_name)\n",
        "    return match.group(1) if match else Mega_name\n",
        "\n",
        "Mega_base_names = Mega_rows.apply(get_base_name).unique()\n",
        "\n",
        "# next lets filter out the mega rows from our main DataFrame to remove duplicates\n",
        "Pokemon = df[~(df['Name'].str.contains('Mega', case=True, na=False) & (df['Name'] != 'Meganium'))].copy()\n",
        "\n",
        "# now we can add the can_mega column to the DataFrame by checking against base names\n",
        "Pokemon['Can_Mega'] = Pokemon['Name'].isin(Mega_base_names)"
      ],
